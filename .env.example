# ===== AI-WorkBench 环境变量模板 =====
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
# 首次启动时这些值会作为种子写入 data/config.json，之后以 config.json 为准（可在"设置"页修改）

# 运行模式：development | production
# production 下 ACCESS_TOKEN 必填，否则启动失败
APP_ENV=development

# 访问口令（登录工作台用，建议强口令）
ACCESS_TOKEN=

# DMXAPI（图像生成 + SoMark 共用一把 key）
DMXAPI_BASE_URL=https://www.dmxapi.cn
DMXAPI_API_KEY=

# 腾讯云 COS 图床（v5）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PREFIX=GraphBed/
